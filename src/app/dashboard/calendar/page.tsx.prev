'use client';

import { useState, useEffect } from 'react';
import { useAuthStore } from '@/lib/store';
import { useRouter } from 'next/navigation';
import Sidebar from '@/components/dashboard/Sidebar';
import MobileNav from '@/components/dashboard/MobileNav';
import Image from 'next/image';
import { Menu, ChevronLeft, ChevronRight, Plus, X, Clock, User, Calendar as CalendarIcon, Check, MapPin, Users, Maximize2, List } from 'lucide-react';

interface Event {
  id: string;
  title: string;
  instructorId: number;
  startTime: string;
  endTime: string;
  date: Date;
  type: 'lesson' | 'training' | 'competition';
  isGroup: boolean;
  location: 'arena' | 'round_pen' | 'lunging' | 'pasture';
  horseId?: number;
  assignHorseLater: boolean;
  clientName?: string;
}

interface LaidOutEvent extends Event {
  lane: number;
  lanes: number;
}

function toMinutes(time: string) {
  const [h, m] = time.split(':').map(Number);
  return h * 60 + (m || 0);
}

function layoutEvents(dayEvents: Event[]): LaidOutEvent[] {
  const sorted = [...dayEvents].sort((a, b) => toMinutes(a.startTime) - toMinutes(b.startTime));
  const lanes: { end: number }[] = [];
  const placed: { event: Event; lane: number }[] = [];

  sorted.forEach((event) => {
    const start = toMinutes(event.startTime);
    const end = toMinutes(event.endTime);
    let laneIndex = lanes.findIndex((lane) => lane.end <= start);
    if (laneIndex === -1) {
      laneIndex = lanes.length;
      lanes.push({ end });
    } else {
      lanes[laneIndex].end = end;
    }
    placed.push({ event, lane: laneIndex });
  });

  const totalLanes = Math.max(lanes.length, 1);
  return placed.map((p) => ({ ...p.event, lane: p.lane, lanes: totalLanes }));
}

function addDays(date: Date, days: number) {
  const d = new Date(date);
  d.setDate(d.getDate() + days);
  return d;
}

function sameDay(a: Date, b: Date) {
  return a.toDateString() === b.toDateString();
}

function toISODate(date: Date) {
  return date.toISOString().split('T')[0];
}

function DayAgendaList({
  date,
  events,
  instructors,
  onEventClick,
  onEmptyAdd,
}: {
  date: Date;
  events: Event[];
  instructors: { id: number; name: string; color: string; textColor: string }[];
  onEventClick: (e: Event) => void;
  onEmptyAdd: () => void;
}) {
  const sorted = [...events].sort((a, b) => toMinutes(a.startTime) - toMinutes(b.startTime));
  const typeLabel = (type: Event['type']) =>
    type === 'lesson' ? 'Lekcja' : type === 'training' ? 'Trening' : 'Zawody';

  if (sorted.length === 0) {
    return (
      <div className="text-center py-10">
        <div className="w-14 h-14 mx-auto mb-3 rounded-full bg-iceBlue flex items-center justify-center text-marineBlue">
          <CalendarIcon className="w-7 h-7" />
        </div>
        <p className="text-sm text-marineBlue mb-4">Brak wizyt w tym dniu</p>
        <button
          onClick={onEmptyAdd}
          className="px-4 py-2 bg-gradient-to-r from-oceanBlue to-marineBlue text-white rounded-xl text-sm font-medium flex items-center gap-2 mx-auto"
        >
          <Plus className="w-4 h-4" />
          Dodaj wizytę
        </button>
      </div>
    );
  }

  return (
    <div className="space-y-2">
      {sorted.map((event) => {
        const instructor = instructors.find((i) => i.id === event.instructorId);
        return (
          <button
            key={event.id}
            onClick={() => onEventClick(event)}
            className="w-full text-left p-3 rounded-xl bg-white border border-iceBlue shadow-sm hover:shadow-md hover:border-oceanBlue/40 transition-all flex items-center gap-3"
          >
            <div className={`w-1.5 self-stretch rounded-full ${instructor?.color}`} />
            <div className="flex-1 min-w-0">
              <div className="flex items-center justify-between gap-2 mb-0.5">
                <span className="font-semibold text-deepNavy text-sm truncate">{event.title}</span>
                <span className="text-xs font-medium text-marineBlue whitespace-nowrap">
                  {event.startTime} - {event.endTime}
                </span>
              </div>
              <div className="flex items-center gap-2 text-xs text-marineBlue truncate">
                <User className="w-3 h-3" />
                <span className="truncate">{event.clientName || 'Brak klienta'}</span>
              </div>
              <div className="flex items-center gap-2 text-xs text-marineBlue mt-1">
                <span className={`px-2 py-0.5 rounded-md text-[10px] font-medium text-white ${instructor?.color || 'bg-oceanBlue'}`}>
                  {instructor?.name}
                </span>
                <span className="px-2 py-0.5 rounded-md text-[10px] font-medium bg-iceBlue text-deepNavy">
                  {typeLabel(event.type)}
                </span>
              </div>
            </div>
          </button>
        );
      })}
    </div>
  );
}

function AgendaView({
  startDate,
  events,
  instructors,
  onEventClick,
}: {
  startDate: Date;
  events: Event[];
  instructors: { id: number; name: string; color: string; textColor: string }[];
  onEventClick: (e: Event) => void;
}) {
  const days: Date[] = [];
  for (let i = 0; i < 14; i++) {
    days.push(addDays(startDate, i));
  }

  const formatDay = (d: Date) => d.toLocaleDateString('pl-PL', { weekday: 'long', day: 'numeric', month: 'long' });
  const periodTotal = days.reduce(
    (sum, day) => sum + events.filter((e) => sameDay(e.date, day)).length,
    0
  );

  return (
    <div className="space-y-4">
      <p className="text-sm text-marineBlue">{periodTotal} wizyt w najbliższych 14 dniach</p>
      {days.map((day) => {
        const dayEvents = events
          .filter((e) => sameDay(e.date, day))
          .sort((a, b) => toMinutes(a.startTime) - toMinutes(b.startTime));
        const isToday = sameDay(day, new Date());
        return (
          <div
            key={toISODate(day)}
            className={`rounded-2xl border p-4 ${isToday ? 'border-oceanBlue bg-oceanBlue/5' : 'border-iceBlue bg-white'}`}
          >
            <div className="flex items-center justify-between mb-3">
              <h3 className={`font-serif font-bold text-sm ${isToday ? 'text-oceanBlue' : 'text-deepNavy'}`}>
                {isToday ? 'Dziś' : formatDay(day)}
              </h3>
              {dayEvents.length > 0 && <span className="text-xs text-marineBlue">{dayEvents.length} wizyt</span>}
            </div>
            <DayAgendaList
              date={day}
              events={dayEvents}
              instructors={instructors}
              onEventClick={onEventClick}
              onEmptyAdd={() => {}}
            />
          </div>
        );
      })}
    </div>
  );
}

export default function CalendarPage() {
