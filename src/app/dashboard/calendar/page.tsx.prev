            >
              <Plus className="w-5 h-5" />
              <span className="hidden sm:inline">Dodaj wizytę</span>
            </button>
          </div>

          {/* Instructor Legend & Filters - Combined */}
          <div className="bg-white rounded-2xl p-3 lg:p-4 shadow-lg border border-iceBlue mb-4">
            <div className="flex flex-wrap items-center gap-2 lg:gap-4">
              <span className="font-serif text-sm lg:text-base font-bold text-deepNavy hidden sm:inline">Instruktorzy:</span>
              {instructors.map((instructor) => (
                <button
                  key={instructor.id}
                  onClick={() => setFilterInstructor(filterInstructor === instructor.id ? null : instructor.id)}
                  className={`flex items-center gap-1.5 lg:gap-2 px-2 py-1 lg:px-3 lg:py-2 rounded-lg transition-all ${
                    filterInstructor === instructor.id
                      ? `${instructor.color} text-white shadow-md`
                      : 'bg-iceBlue/30 text-deepNavy hover:bg-iceBlue/50'
                  }`}
                >
                  <div className={`w-2 h-2 lg:w-3 lg:h-3 rounded-full ${filterInstructor === instructor.id ? 'bg-white' : instructor.color}`} />
                  <span className="text-xs lg:text-sm font-medium">{instructor.name}</span>
                </button>
              ))}
              {filterInstructor && (
                <button
                  onClick={() => setFilterInstructor(null)}
                  className="text-marineBlue hover:text-deepNavy transition-colors p-1"
                >
                  <X className="w-3 h-3 lg:w-4 lg:h-4" />
                </button>
              )}
              <div className="w-px h-6 bg-iceBlue mx-2 hidden sm:block" />
              <span className="font-serif text-sm lg:text-base font-bold text-deepNavy hidden sm:inline">Typ:</span>
              {['all', 'lesson', 'training', 'competition'].map((type) => (
                <button
                  key={type}
                  onClick={() => setFilterType(type)}
                  className={`px-2 py-1 lg:px-3 lg:py-2 rounded-lg text-xs lg:text-sm font-medium transition-all ${
                    filterType === type
                      ? 'bg-gradient-to-r from-oceanBlue to-marineBlue text-white shadow-md'
                      : 'bg-iceBlue/30 text-deepNavy hover:bg-iceBlue/50'
                  }`}
                >
                  {type === 'all' ? 'Wszystkie' : type === 'lesson' ? 'Lekcje' : type === 'training' ? 'Treningi' : 'Zawody'}
                </button>
              ))}
            </div>
          </div>

          {/* View Mode Selector */}
          <div className="grid grid-cols-4 gap-2 mb-4 bg-white rounded-xl p-1.5 border border-iceBlue lg:inline-flex lg:w-auto">
            {[
              { key: 'week', label: 'Tydzień' },
              { key: 'month', label: 'Miesiąc' },
              { key: 'day', label: 'Dzień' },
              { key: 'agenda', label: 'Lista' },
            ].map((mode) => (
              <button
                key={mode.key}
                onClick={() => setViewMode(mode.key as typeof viewMode)}
