  const [filterType, setFilterType] = useState<string>('all');
  const [selectedClients, setSelectedClients] = useState<string[]>([]);
  const [clientSearch, setClientSearch] = useState('');
  const [showAddClientForm, setShowAddClientForm] = useState(false);
  const [selectedService, setSelectedService] = useState<string>('');
  const [duration, setDuration] = useState(60);
  const [mobileDay, setMobileDay] = useState(new Date());
  const [mobileInstructorId, setMobileInstructorId] = useState(1);
  const [agendaStart, setAgendaStart] = useState(new Date());
  const [dayDetailsDate, setDayDetailsDate] = useState<Date | null>(null);

  useEffect(() => {
    const check = () => setIsDesktop(window.innerWidth >= 1024);
    check();
    window.addEventListener('resize', check);
    return () => window.removeEventListener('resize', check);
  }, []);

  const rowHeight = isDesktop ? 60 : 50;

  if (!isAuthenticated()) {
    router.push('/login');
    return null;
  }

  const instructors = [
    { id: 1, name: 'Anna Kowalska', color: 'bg-oceanBlue', textColor: 'text-oceanBlue' },
    { id: 2, name: 'Piotr Nowak', color: 'bg-marineBlue', textColor: 'text-marineBlue' },
    { id: 3, name: 'Maria Wiśniewska', color: 'bg-deepNavy', textColor: 'text-deepNavy' },
    { id: 4, name: 'Jan Kowalczyk', color: 'bg-arcticBlue', textColor: 'text-arcticBlue' },
  ];

  const horses = [
    { id: 1, name: 'Błyskawica' },
    { id: 2, name: 'Gwiazda' },
    { id: 3, name: 'Huragan' },
    { id: 4, name: 'Słońce' },
    { id: 5, name: 'Wiatr' },
  ];

  const locations = [
    { value: 'arena', label: 'Ujeżdżalnia', icon: <MapPin className="w-5 h-5" /> },
    { value: 'round_pen', label: 'Lonżownik', icon: <Clock className="w-5 h-5" /> },
    { value: 'lunging', label: 'Karuzela', icon: <Users className="w-5 h-5" /> },
    { value: 'pasture', label: 'Pastwisko', icon: <Maximize2 className="w-5 h-5" /> },
  ];

  const clients = [
    { id: 1, name: 'Jan Nowak', email: 'jan.nowak@email.com' },
    { id: 2, name: 'Anna Kowalska', email: 'anna.kowalska@email.com' },
    { id: 3, name: 'Maria Wiśniewska', email: 'maria.wisniewska@email.com' },
    { id: 4, name: 'Piotr Zieliński', email: 'piotr.zielinski@email.com' },
    { id: 5, name: 'Katarzyna Wojciechowska', email: 'katarzyna.wojciechowska@email.com' },
  ];

  const services = [
    { id: 1, name: 'Lekcja indywidualna', duration: 60 },
    { id: 2, name: 'Lekcja grupowa', duration: 90 },
    { id: 3, name: 'Trening', duration: 120 },
    { id: 4, name: 'Zawody', duration: 180 },
  ];

  const [events, setEvents] = useState<Event[]>(() => {
    if (typeof window !== 'undefined') {
      const saved = localStorage.getItem('calendar-events');
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          return parsed.map((e: any) => ({
            ...e,
            date: new Date(e.date)
          }));
        } catch (e) {
          return [
            { id: '1', title: 'Lekcja indywidualna', instructorId: 1, startTime: '10:00', endTime: '11:00', date: new Date(), type: 'lesson', isGroup: false, location: 'arena', horseId: 1, assignHorseLater: false, clientName: 'Jan Nowak' },
            { id: '2', title: 'Trening grupowy', instructorId: 2, startTime: '14:00', endTime: '15:30', date: new Date(), type: 'training', isGroup: true, location: 'round_pen', horseId: 2, assignHorseLater: false, clientName: 'Anna Kowalska' },
            { id: '3', title: 'Zawody', instructorId: 3, startTime: '16:00', endTime: '18:00', date: new Date(), type: 'competition', isGroup: true, location: 'arena', horseId: 3, assignHorseLater: true, clientName: 'Maria Wiśniewska' },
          ];
        }
      }
    }
    return [
      { id: '1', title: 'Lekcja indywidualna', instructorId: 1, startTime: '10:00', endTime: '11:00', date: new Date(), type: 'lesson', isGroup: false, location: 'arena', horseId: 1, assignHorseLater: false, clientName: 'Jan Nowak' },
      { id: '2', title: 'Trening grupowy', instructorId: 2, startTime: '14:00', endTime: '15:30', date: new Date(), type: 'training', isGroup: true, location: 'round_pen', horseId: 2, assignHorseLater: false, clientName: 'Anna Kowalska' },
      { id: '3', title: 'Zawody', instructorId: 3, startTime: '16:00', endTime: '18:00', date: new Date(), type: 'competition', isGroup: true, location: 'arena', horseId: 3, assignHorseLater: true, clientName: 'Maria Wiśniewska' },
    ];
  });

  // Save events to localStorage whenever they change
  useEffect(() => {
    if (typeof window !== 'undefined') {
      localStorage.setItem('calendar-events', JSON.stringify(events));
    }
  }, [events]);

  const weekDays = ['Pon', 'Wt', 'Śr', 'Czw', 'Pt', 'Sob', 'Nd'];
  const hours = Array.from({ length: 12 }, (_, i) => i + 8); // 8:00 - 19:00

  const navigateWeek = (direction: 'prev' | 'next') => {
    const newDate = new Date(currentDate);
    newDate.setDate(newDate.getDate() + (direction === 'next' ? 7 : -7));
    setCurrentDate(newDate);
  };

  const navigateDay = (direction: 'prev' | 'next') => {
    const newDate = addDays(currentDate, direction === 'next' ? 1 : -1);
    setCurrentDate(newDate);
  };

  const navigateMonth = (direction: 'prev' | 'next') => {
    const newDate = new Date(currentDate);
    newDate.setMonth(newDate.getMonth() + (direction === 'next' ? 1 : -1));
    setCurrentDate(newDate);
  };

  const getWeekDates = () => {
    const dates = [];
    const startOfWeek = new Date(currentDate);
    const day = startOfWeek.getDay();
    const diff = startOfWeek.getDate() - day + (day === 0 ? -6 : 1);
    startOfWeek.setDate(diff);

    for (let i = 0; i < 7; i++) {
      const date = new Date(startOfWeek);
      date.setDate(startOfWeek.getDate() + i);
      dates.push(date);
    }
    return dates;
  };

  const getMonthDates = () => {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);
    const startDay = firstDay.getDay(); // 0 = Sunday
    const totalDays = lastDay.getDate();

    const dates: (Date | null)[] = [];
    const blanks = (startDay + 6) % 7; // Monday as first day of week
    for (let i = 0; i < blanks; i++) {
      dates.push(null);
    }
    for (let i = 1; i <= totalDays; i++) {
      dates.push(new Date(year, month, i));
    }
    return dates;
  };

  const formatDate = (date: Date) => {
    return date.toLocaleDateString('pl-PL', { day: 'numeric', month: 'short' });
  };

  const formatMonthYear = (date: Date) => {
    return date.toLocaleDateString('pl-PL', { month: 'long', year: 'numeric' });
  };

  const formatWeekRange = () => {
    const weekDates = getWeekDates();
    return `${formatDate(weekDates[0])} - ${formatDate(weekDates[6])}`;
  };

  const getFilteredEvents = () => {
    return events.filter(event => {
      if (filterInstructor && event.instructorId !== filterInstructor) return false;
      if (filterType !== 'all' && event.type !== filterType) return false;
      return true;
    });
  };

  const handleEventClick = (event: Event) => {
    setSelectedEvent(event);
    setShowEventModal(true);
  };

  const handleAddEvent = () => {
    setAddStep(1);
    setSelectedInstructor(null);
    setSelectedDate(null);
    setSelectedTime('');
    setSelectedType('lesson');
    setIsGroup(false);
    setSelectedLocation('arena');
    setSelectedHorse(null);
    setAssignHorseLater(false);
    setSelectedClients([]);
    setClientSearch('');
    setShowAddClientForm(false);
    setSelectedService('');
    setDuration(60);
    setShowAddModal(true);
  };

  const handleAddEventSubmit = () => {
    if (selectedInstructor && selectedDate && selectedTime && selectedClients.length > 0) {
      const startHour = parseInt(selectedTime);
      const endHour = startHour + Math.floor(duration / 60);
      const endMinute = duration % 60;
      const endTime = `${endHour}:${endMinute.toString().padStart(2, '0')}`;
      
      const clientNames = selectedClients.join(', ');
      
      const newEvent: Event = {
        id: Date.now().toString(),
        title: selectedService || 'Zajęcia',
        instructorId: selectedInstructor,
        startTime: selectedTime,
        endTime: endTime,
        date: selectedDate,
        type: selectedType,
        isGroup: selectedClients.length > 1,
        location: selectedLocation,
        horseId: assignHorseLater ? undefined : (selectedHorse || undefined),
        assignHorseLater,
        clientName: clientNames,
      };
      setEvents([...events, newEvent]);
      setShowAddModal(false);
    }
