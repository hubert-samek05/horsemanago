                  viewMode === mode.key
                    ? 'bg-gradient-to-r from-oceanBlue to-marineBlue text-white shadow-md'
                    : 'text-marineBlue hover:bg-iceBlue/50'
                }`}
              >
                {mode.label}
              </button>
            ))}
          </div>

          {/* Calendar Navigation */}
          <div className="bg-white rounded-2xl p-3 lg:p-4 shadow-lg border border-iceBlue mb-4">
            {viewMode === 'agenda' ? (
              <div className="flex flex-wrap items-center gap-2 mb-4">
                <List className="w-5 h-5 text-oceanBlue shrink-0" />
                <h2 className="font-serif text-lg lg:text-xl font-bold text-deepNavy mr-auto">Nadchodzące jazdy</h2>
                <input
                  type="date"
                  value={toISODate(agendaStart)}
                  onChange={(e) => setAgendaStart(new Date(e.target.value))}
                  className="px-3 py-1.5 rounded-lg border border-iceBlue text-sm text-deepNavy focus:outline-none focus:border-oceanBlue"
                />
                <button
                  onClick={() => setAgendaStart(new Date())}
                  className="px-3 py-1.5 rounded-lg bg-iceBlue/40 text-deepNavy text-sm font-medium hover:bg-iceBlue transition-colors"
                >
                  Dziś
                </button>
              </div>
            ) : (
              <div className="flex items-center justify-between mb-4">
                <button
                  onClick={() => viewMode === 'month' ? navigateMonth('prev') : viewMode === 'day' ? navigateDay('prev') : navigateWeek('prev')}
                  className="p-2 hover:bg-iceBlue rounded-lg transition-colors"
                >
                  <ChevronLeft className="w-5 h-5 text-deepNavy" />
                </button>
                <h2 className="font-serif text-base sm:text-xl font-bold text-deepNavy text-center">
                  {viewMode === 'month'
                    ? formatMonthYear(currentDate)
                    : viewMode === 'day'
                    ? currentDate.toLocaleDateString('pl-PL', { weekday: 'long', day: 'numeric', month: 'long' })
                    : formatWeekRange()}
                </h2>
                <button
                  onClick={() => viewMode === 'month' ? navigateMonth('next') : viewMode === 'day' ? navigateDay('next') : navigateWeek('next')}
                  className="p-2 hover:bg-iceBlue rounded-lg transition-colors"
                >
                  <ChevronRight className="w-5 h-5 text-deepNavy" />
                </button>
              </div>
            )}

            {/* Week View */}
            {viewMode === 'week' && (
              <>
                {/* Mobile: day tabs + vertical agenda list for selected day */}
                <div className="lg:hidden">
                  <div className="flex gap-1.5 overflow-x-auto pb-2 mb-3 -mx-1 px-1">
                    {getWeekDates().map((date, index) => {
                      const isSelected = sameDay(date, mobileDay);
                      const dayEventsCount = getFilteredEvents().filter(e => sameDay(e.date, date)).length;
                      return (
                        <button
                          key={index}
                          onClick={() => setMobileDay(date)}
                          className={`flex-shrink-0 w-14 py-2 rounded-xl border transition-all ${
                            isSelected
                              ? 'bg-gradient-to-r from-oceanBlue to-marineBlue text-white border-transparent shadow-md'
                              : 'border-iceBlue text-deepNavy hover:bg-iceBlue/30'
                          }`}
                        >
                          <div className="text-[10px] font-medium opacity-80">{weekDays[index]}</div>
                          <div className="text-sm font-semibold">{date.getDate()}</div>
                          {dayEventsCount > 0 && (
                            <div className={`mx-auto mt-1 w-1 h-1 rounded-full ${isSelected ? 'bg-white' : 'bg-oceanBlue'}`} />
                          )}
                        </button>
                      );
                    })}
                  </div>

                  <DayAgendaList
                    date={mobileDay}
                    events={getFilteredEvents().filter(e => sameDay(e.date, mobileDay))}
                    instructors={instructors}
                    onEventClick={handleEventClick}
                    onEmptyAdd={() => {
                      setSelectedDate(mobileDay);
                      setSelectedTime('');
                      setShowAddModal(true);
                    }}
                  />
                </div>

                {/* Desktop: full grid with correct overlap (lane) layout */}
                <div className="hidden lg:block overflow-x-auto">
                  <div className="min-w-[800px]">
                    <div className="grid grid-cols-8 gap-px bg-iceBlue mb-2">
                      <div className="bg-white p-2 text-sm font-semibold text-marineBlue">Godz</div>
                      {weekDays.map((day, index) => {
                        const weekDates = getWeekDates();
                        return (
                          <div key={index} className="bg-white p-2 text-center">
                            <div className="text-sm font-semibold text-deepNavy">{day}</div>
                            <div className="text-xs text-marineBlue">{formatDate(weekDates[index])}</div>
                          </div>
                        );
                      })}
                    </div>
                    <div className="relative">
                      <div className="grid grid-cols-8 gap-px bg-iceBlue">
                        {hours.map((hour) => (
                          <div key={hour} className="contents">
                            <div className="bg-white p-2 text-sm text-marineBlue text-right pr-2 h-[60px]">{hour}:00</div>
                            {weekDays.map((_, dayIndex) => (
                              <div
                                key={dayIndex}
                                className="bg-white h-[60px] hover:bg-iceBlue/20 transition-colors cursor-pointer border-b border-iceBlue/30"
                                onClick={() => {
                                  const weekDates = getWeekDates();
                                  setSelectedDate(weekDates[dayIndex]);
                                  setSelectedTime(`${hour}:00`);
                                  setShowAddModal(true);
                                }}
                              />
                            ))}
                          </div>
                        ))}
                      </div>

                      <div className="absolute inset-0 pointer-events-none">
                        {weekDays.map((_, dayIndex) => {
                          const weekDates = getWeekDates();
                          const dayEvents = getFilteredEvents().filter(
                            e => e.date.toDateString() === weekDates[dayIndex].toDateString()
                          );
                          const laidOut = layoutEvents(dayEvents);

                          return (
                            <div key={dayIndex} className="absolute" style={{
                              left: `calc(${(dayIndex + 1) * 12.5}% + 1px)`,
                              width: 'calc(12.5% - 2px)',
                              top: 0,
                              bottom: 0,
                            }}>
                              {laidOut.map((event) => {
                                const instructor = instructors.find(i => i.id === event.instructorId);
                                const startOffset = (toMinutes(event.startTime) - hours[0] * 60) / 60;
                                const durationHours = (toMinutes(event.endTime) - toMinutes(event.startTime)) / 60;
                                const widthPct = 100 / event.lanes;

                                return (
                                  <div
                                    key={event.id}
                                    className={`absolute ${instructor?.color} text-white p-1 lg:p-1.5 text-[9px] lg:text-[10px] font-medium flex flex-col justify-center rounded shadow-sm hover:shadow-md transition-shadow cursor-pointer pointer-events-auto`}
                                    style={{
                                      top: `${startOffset * 60 + 2}px`,
                                      height: `${Math.max(durationHours * 60 - 2, 22)}px`,
                                      left: `${event.lane * widthPct}%`,
                                      width: `calc(${widthPct}% - 2px)`,
                                    }}
                                    onClick={(e) => {
                                      e.stopPropagation();
                                      handleEventClick(event);
                                    }}
                                  >
                                    <span className="truncate font-semibold text-[9px] lg:text-[10px] leading-tight">{event.title}</span>
                                    <span className="opacity-90 truncate text-[9px] lg:text-[10px] leading-tight">{event.clientName}</span>
                                    <span className="opacity-70 text-[9px] lg:text-[10px] leading-tight">{event.startTime} - {event.endTime}</span>
                                  </div>
                                );
                              })}
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              </>
            )}

            {/* Month View */}
            {viewMode === 'month' && (
              <div className="grid grid-cols-7 gap-1 sm:gap-2">
                {weekDays.map((day) => (
                  <div key={day} className="text-center text-[10px] sm:text-sm font-semibold text-deepNavy py-1 sm:py-2">
                    {day}
                  </div>
                ))}
                {getMonthDates().map((date, index) => {
                  if (!date) return <div key={index} className="min-h-[64px] sm:min-h-[100px]" />;
                  const dayEvents = getFilteredEvents().filter(e => sameDay(e.date, date));
                  const isToday = sameDay(date, new Date());
                  return (
                    <button
                      key={index}
                      onClick={() => (dayEvents.length > 0 ? setDayDetailsDate(date) : (setSelectedDate(date), setSelectedTime(''), setShowAddModal(true)))}
                      className={`min-h-[64px] sm:min-h-[100px] p-1 sm:p-2 rounded-lg border text-left transition-colors ${
                        isToday ? 'border-oceanBlue bg-oceanBlue/5' : 'border-iceBlue bg-iceBlue/30 hover:border-oceanBlue/50'
                      }`}
                    >
                      <div className={`text-xs sm:text-sm font-medium mb-1 ${isToday ? 'text-oceanBlue' : 'text-deepNavy'}`}>{date.getDate()}</div>
                      <div className="space-y-1">
                        {dayEvents.slice(0, 2).map((event) => {
                          const instructor = instructors.find(i => i.id === event.instructorId);
                          return (
                            <div
                              key={event.id}
                              className={`text-[9px] sm:text-xs px-1.5 sm:px-2 py-0.5 sm:py-1 rounded ${instructor?.color} text-white truncate`}
                            >
                              {event.startTime} {event.title}
                            </div>
                          );
                        })}
                        {dayEvents.length > 2 && (
                          <div className="text-[9px] sm:text-xs text-marineBlue font-medium">+{dayEvents.length - 2} więcej</div>
                        )}
                      </div>
                    </button>
                  );
                })}
              </div>
            )}

            {/* Day View */}
            {viewMode === 'day' && (
              <>
                {/* Mobile: instructor tabs + vertical list */}
                <div className="lg:hidden">
                  <div className="flex gap-1.5 overflow-x-auto pb-2 mb-3 -mx-1 px-1">
                    {instructors.map((instructor) => {
                      const isSelected = mobileInstructorId === instructor.id;
                      const count = getFilteredEvents().filter(e => sameDay(e.date, currentDate) && e.instructorId === instructor.id).length;
                      return (
                        <button
                          key={instructor.id}
                          onClick={() => setMobileInstructorId(instructor.id)}
                          className={`flex-shrink-0 px-3 py-2 rounded-xl border transition-all flex items-center gap-2 ${
                            isSelected
                              ? `${instructor.color} text-white border-transparent shadow-md`
                              : 'border-iceBlue text-deepNavy hover:bg-iceBlue/30'
                          }`}
                        >
                          <span className="text-sm font-medium whitespace-nowrap">{instructor.name}</span>
                          {count > 0 && (
                            <span className={`text-[10px] px-1.5 rounded-full ${isSelected ? 'bg-white/25' : 'bg-iceBlue'}`}>{count}</span>
                          )}
                        </button>
                      );
                    })}
                  </div>

                  <DayAgendaList
                    date={currentDate}
                    events={getFilteredEvents().filter(e => sameDay(e.date, currentDate) && e.instructorId === mobileInstructorId)}
                    instructors={instructors}
                    onEventClick={handleEventClick}
                    onEmptyAdd={() => {
                      setSelectedDate(currentDate);
                      setSelectedTime('');
                      setSelectedInstructor(mobileInstructorId);
                      setShowAddModal(true);
                    }}
                  />
                </div>

                {/* Desktop: instructor columns with correct overlap (lane) layout */}
                <div className="hidden lg:block overflow-x-auto">
                  <div className="min-w-[800px]">
                    <div className="grid grid-cols-5 gap-px bg-iceBlue mb-2">
                      <div className="bg-white p-2 text-sm font-semibold text-marineBlue">Godz</div>
                      {instructors.map((instructor) => (
                        <div key={instructor.id} className="bg-white p-2 text-center">
                          <div className="text-sm font-semibold text-deepNavy">{instructor.name}</div>
                        </div>
                      ))}
                    </div>
                    <div className="relative">
                      <div className="grid grid-cols-5 gap-px bg-iceBlue">
                        {hours.map((hour) => (
                          <div key={hour} className="contents">
                            <div className="bg-white p-2 text-sm text-marineBlue text-right pr-2 h-[60px]">{hour}:00</div>
                            {instructors.map((instructor) => (
                              <div
                                key={instructor.id}
                                className="bg-white h-[60px] hover:bg-iceBlue/20 transition-colors cursor-pointer border-b border-iceBlue/30"
                                onClick={() => {
                                  setSelectedDate(currentDate);
                                  setSelectedTime(`${hour}:00`);
                                  setSelectedInstructor(instructor.id);
                                  setShowAddModal(true);
                                }}
                              />
                            ))}
                          </div>
                        ))}
                      </div>

                      <div className="absolute inset-0 pointer-events-none">
                        {instructors.map((instructor, instructorIndex) => {
                          const instructorEvents = getFilteredEvents().filter(
                            e => sameDay(e.date, currentDate) && e.instructorId === instructor.id
                          );
                          const laidOut = layoutEvents(instructorEvents);

                          return (
                            <div key={instructor.id} className="absolute" style={{
                              left: `calc(${(instructorIndex + 1) * 20}% + 1px)`,
                              width: 'calc(20% - 2px)',
                              top: 0,
                              bottom: 0,
                            }}>
                              {laidOut.map((event) => {
                                const startOffset = (toMinutes(event.startTime) - hours[0] * 60) / 60;
                                const durationHours = (toMinutes(event.endTime) - toMinutes(event.startTime)) / 60;
                                const widthPct = 100 / event.lanes;

                                return (
                                  <div
                                    key={event.id}
                                    className={`absolute ${instructor.color} text-white p-1 lg:p-1.5 text-[9px] lg:text-[10px] font-medium flex flex-col justify-center rounded shadow-sm hover:shadow-md transition-shadow cursor-pointer pointer-events-auto`}
                                    style={{
                                      top: `${startOffset * 60 + 2}px`,
                                      height: `${Math.max(durationHours * 60 - 2, 22)}px`,
                                      left: `${event.lane * widthPct}%`,
                                      width: `calc(${widthPct}% - 2px)`,
                                    }}
                                    onClick={(e) => {
                                      e.stopPropagation();
                                      handleEventClick(event);
                                    }}
                                  >
                                    <span className="truncate font-semibold text-[9px] lg:text-[10px] leading-tight">{event.title}</span>
                                    <span className="opacity-90 truncate text-[9px] lg:text-[10px] leading-tight">{event.clientName}</span>
                                    <span className="opacity-70 text-[9px] lg:text-[10px] leading-tight">{event.startTime} - {event.endTime}</span>
                                  </div>
                                );
                              })}
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              </>
            )}

            {/* Agenda View (4th mode): all rides stacked per day, with date selection */}
            {viewMode === 'agenda' && (
              <AgendaView
                startDate={agendaStart}
                events={getFilteredEvents()}
                instructors={instructors}
                onEventClick={handleEventClick}
              />
            )}
          </div>
        </div>
      </div>

      {/* Day Details Sheet (from Month view) */}
      {dayDetailsDate && (
        <div className="fixed inset-0 bg-black/50 flex items-end sm:items-center justify-center z-50" onClick={() => setDayDetailsDate(null)}>
          <div
            className="bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-3xl shadow-2xl max-h-[80vh] flex flex-col"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="px-5 pt-4 pb-3 border-b border-iceBlue shrink-0">
              <div className="w-10 h-1 rounded-full bg-iceBlue mx-auto mb-3 sm:hidden" />
              <div className="flex items-center justify-between">
                <h3 className="font-serif text-lg font-bold text-deepNavy capitalize">
                  {dayDetailsDate.toLocaleDateString('pl-PL', { weekday: 'long', day: 'numeric', month: 'long' })}
                </h3>
                <button onClick={() => setDayDetailsDate(null)} className="p-2 hover:bg-iceBlue rounded-lg transition-colors">
                  <X className="w-5 h-5 text-deepNavy" />
                </button>
              </div>
            </div>
            <div className="p-4 overflow-y-auto flex-1">
              <DayAgendaList
                date={dayDetailsDate}
                events={getFilteredEvents().filter(e => sameDay(e.date, dayDetailsDate))}
                instructors={instructors}
                onEventClick={(event) => { setDayDetailsDate(null); handleEventClick(event); }}
                onEmptyAdd={() => {
                  setSelectedDate(dayDetailsDate);
                  setSelectedTime('');
                  setDayDetailsDate(null);
                  setShowAddModal(true);
                }}
              />
            </div>
            <div className="p-4 border-t border-iceBlue shrink-0">
              <button
                onClick={() => {
                  setSelectedDate(dayDetailsDate);
                  setSelectedTime('');
                  setDayDetailsDate(null);
                  setShowAddModal(true);
                }}
                className="w-full px-4 py-3 rounded-xl bg-gradient-to-r from-oceanBlue to-marineBlue text-white font-medium flex items-center justify-center gap-2"
              >
                <Plus className="w-4 h-4" />
                Dodaj wizytę tego dnia
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Add Event Modal */}
      {showAddModal && (
        <div className="fixed inset-0 bg-black/50 flex items-end sm:items-center justify-center z-50">
          <div className="bg-white rounded-t-3xl sm:rounded-3xl shadow-2xl w-full sm:max-w-lg h-[90vh] sm:h-[min(90vh,800px)] flex flex-col overflow-hidden">
            <div className="p-4 sm:p-6 flex flex-col h-full overflow-hidden">
              <div className="flex items-center justify-between mb-4 shrink-0">
                <h2 className="font-serif text-lg sm:text-xl font-bold text-deepNavy">Dodaj zajęcia</h2>
                <button
                  onClick={() => setShowAddModal(false)}
                  className="p-2 hover:bg-iceBlue rounded-lg transition-colors"
                >
                  <X className="w-5 h-5 text-deepNavy" />
                </button>
              </div>

              {/* Step Indicator */}
              <div className="flex items-center justify-center gap-2 mb-4 shrink-0">
                {[1, 2, 3, 4, 5, 6].map((step) => (
                  <div
                    key={step}
                    className={`w-2 h-2 rounded-full transition-all ${
                      addStep >= step ? 'bg-oceanBlue' : 'bg-iceBlue'
                    }`}
                  />
                ))}
              </div>

              <div className="flex-1 min-h-0 overflow-y-auto">

              {/* Step 1: Select Client */}
              {addStep === 1 && (
                <div className="space-y-3">
                  <h3 className="font-serif text-base font-semibold text-deepNavy mb-3">Wybierz klientów</h3>
                  
                  {/* Selected clients */}
                  {selectedClients.length > 0 && (
                    <div className="flex flex-wrap gap-2 mb-3">
                      {selectedClients.map((client, index) => (
                        <div
                          key={index}
                          className="flex items-center gap-2 px-3 py-1.5 bg-oceanBlue/10 text-oceanBlue rounded-full text-sm"
                        >
                          <span>{client}</span>
                          <button
                            onClick={() => setSelectedClients(selectedClients.filter((_, i) => i !== index))}
                            className="hover:text-oceanBlue/70"
                          >
                            <X className="w-3 h-3" />
                          </button>
                        </div>
                      ))}
                    </div>
                  )}
                  
                  <div className="relative">
                    <input
                      type="text"
                      placeholder="Wpisz imię i nazwisko..."
                      value={clientSearch}
                      onChange={(e) => {
                        setClientSearch(e.target.value);
                        setShowAddClientForm(false);
                      }}
                      className="w-full px-4 py-3 rounded-xl border border-iceBlue focus:outline-none focus:border-oceanBlue text-deepNavy text-sm"
                    />
                    {clientSearch && (
                      <div className="absolute top-full left-0 right-0 mt-1 bg-white border border-iceBlue rounded-xl shadow-lg z-10 max-h-48 overflow-y-auto">
                        {clients
                          .filter(c => c.name.toLowerCase().includes(clientSearch.toLowerCase()) && !selectedClients.includes(c.name))
                          .map((client) => (
                            <button
                              key={client.id}
                              onClick={() => {
                                setSelectedClients([...selectedClients, client.name]);
                                setClientSearch('');
                              }}
                              className="w-full px-4 py-2 text-left hover:bg-iceBlue/20 transition-colors text-sm text-deepNavy"
                            >
                              {client.name}
                            </button>
                          ))}
                        {clients.filter(c => c.name.toLowerCase().includes(clientSearch.toLowerCase()) && !selectedClients.includes(c.name)).length === 0 && (
                          <button
                            onClick={() => setShowAddClientForm(true)}
                            className="w-full px-4 py-2 text-left hover:bg-iceBlue/20 transition-colors text-sm text-oceanBlue font-medium"
                          >
                            + Dodaj nowego klienta
                          </button>
                        )}
                      </div>
                    )}
                  </div>
                  
                  {showAddClientForm && (
                    <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
                      <div className="bg-white rounded-2xl shadow-2xl w-full max-w-md">
                        <div className="p-6">
                          <h3 className="font-serif text-xl font-bold text-deepNavy mb-4">Dodaj nowego klienta</h3>
                          <div className="space-y-4">
                            <div>
                              <label className="block text-sm font-medium text-deepNavy mb-2">Imię i nazwisko</label>
                              <input
                                type="text"
                                placeholder="Jan Kowalski"
                                value={clientSearch}
                                onChange={(e) => setClientSearch(e.target.value)}
                                className="w-full px-4 py-3 rounded-xl border border-iceBlue focus:outline-none focus:ring-2 focus:ring-oceanBlue/50 text-deepNavy"
                              />
                            </div>
                            <div>
                              <label className="block text-sm font-medium text-deepNavy mb-2">Numer telefonu</label>
                              <input
                                type="tel"
                                placeholder="+48 123 456 789"
                                className="w-full px-4 py-3 rounded-xl border border-iceBlue focus:outline-none focus:ring-2 focus:ring-oceanBlue/50 text-deepNavy"
                              />
                            </div>
                            <div>
                              <label className="block text-sm font-medium text-deepNavy mb-2">Email (opcjonalnie)</label>
                              <input
                                type="email"
                                placeholder="jan.kowalski@email.com"
                                className="w-full px-4 py-3 rounded-xl border border-iceBlue focus:outline-none focus:ring-2 focus:ring-oceanBlue/50 text-deepNavy"
                              />
                            </div>
                            <div className="flex gap-3 pt-2">
                              <button
                                onClick={() => setShowAddClientForm(false)}
                                className="flex-1 px-4 py-3 rounded-xl border border-iceBlue text-deepNavy hover:bg-iceBlue/20 transition-colors font-medium"
                              >
                                Anuluj
                              </button>
                              <button
                                onClick={() => {
                                  if (clientSearch) {
                                    setSelectedClients([...selectedClients, clientSearch]);
                                    setClientSearch('');
                                    setShowAddClientForm(false);
                                  }
                                }}
                                disabled={!clientSearch}
                                className="flex-1 px-4 py-3 rounded-xl bg-gradient-to-r from-oceanBlue to-marineBlue text-white disabled:opacity-50 disabled:cursor-not-allowed hover:shadow-lg transition-all font-medium"
                              >
                                Dodaj i kontynuuj
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}
                  
                  <div className="flex gap-2">
                    <button
                      onClick={() => selectedClients.length > 0 && setAddStep(2)}
                      disabled={selectedClients.length === 0}
                      className="flex-1 px-3 py-2 rounded-xl bg-gradient-to-r from-oceanBlue to-marineBlue text-white disabled:opacity-50 disabled:cursor-not-allowed hover:shadow-lg transition-all text-sm"
                    >
                      Dalej ({selectedClients.length})
                    </button>
                  </div>
                </div>
              )}

              {/* Step 2: Select Service */}
              {addStep === 2 && (
                <div className="space-y-3">
                  <h3 className="font-serif text-base font-semibold text-deepNavy mb-3">Typ zajęć</h3>
                  <div className="space-y-2">
                    {services.map((service) => (
                      <button
                        key={service.id}
                        onClick={() => {
                          setSelectedService(service.name);
                          setDuration(service.duration);
                          setAddStep(3);
                        }}
                        className={`w-full p-3 rounded-xl border-2 transition-all flex items-center justify-between ${
                          selectedService === service.name
                            ? 'bg-gradient-to-r from-oceanBlue to-marineBlue text-white border-transparent shadow-lg'
                            : 'border-iceBlue hover:border-oceanBlue text-deepNavy'
                        }`}
                      >
                        <span className="font-medium text-sm">{service.name}</span>
                        <span className="text-xs opacity-80">{service.duration} min</span>
                      </button>
                    ))}
                  </div>
                  <div className="flex gap-2">
                    <button
                      onClick={() => setAddStep(1)}
                      className="flex-1 px-3 py-2 rounded-xl border border-iceBlue text-deepNavy hover:bg-iceBlue transition-colors text-sm"
                    >
                      Wstecz
                    </button>
                  </div>
                </div>
              )}

              {/* Step 3: Date, Time and Duration */}
              {addStep === 3 && (
                <div className="space-y-3">
                  <h3 className="font-serif text-base font-semibold text-deepNavy mb-3">Data, godzina i czas trwania</h3>
                  
                  <div>
                    <label className="block text-xs font-medium text-deepNavy mb-2">Data</label>
                    <input
                      type="date"
                      value={selectedDate ? selectedDate.toISOString().split('T')[0] : ''}
                      onChange={(e) => setSelectedDate(new Date(e.target.value))}
                      className="w-full px-3 py-2 rounded-xl border border-iceBlue focus:outline-none focus:border-oceanBlue text-deepNavy text-sm"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-deepNavy mb-2">Godzina rozpoczęcia</label>
                    <div className="grid grid-cols-4 gap-2">
                      {hours.map((hour) => (
                        <button
                          key={hour}
                          onClick={() => setSelectedTime(`${hour}:00`)}
                          className={`p-2 rounded-xl border-2 transition-all text-sm ${
                            selectedTime === `${hour}:00`
                              ? 'bg-gradient-to-r from-oceanBlue to-marineBlue text-white border-transparent shadow-lg'
                              : 'border-iceBlue hover:border-oceanBlue text-deepNavy'
                          }`}
                        >
                          {hour}:00
                        </button>
                      ))}
                    </div>
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-deepNavy mb-2">Czas trwania (minuty)</label>
                    <input
                      type="number"
                      value={duration}
                      onChange={(e) => setDuration(parseInt(e.target.value))}
                      min="30"
                      step="15"
                      className="w-full px-3 py-2 rounded-xl border border-iceBlue focus:outline-none focus:border-oceanBlue text-deepNavy text-sm"
                    />
                  </div>

                  <div className="flex gap-2">
                    <button
                      onClick={() => setAddStep(2)}
                      className="flex-1 px-3 py-2 rounded-xl border border-iceBlue text-deepNavy hover:bg-iceBlue transition-colors text-sm"
                    >
                      Wstecz
                    </button>
                    <button
                      onClick={() => selectedDate && selectedTime && setAddStep(4)}
                      disabled={!selectedDate || !selectedTime}
                      className="flex-1 px-3 py-2 rounded-xl bg-gradient-to-r from-oceanBlue to-marineBlue text-white disabled:opacity-50 disabled:cursor-not-allowed hover:shadow-lg transition-all text-sm"
                    >
                      Dalej
                    </button>
                  </div>
                </div>
              )}

              {/* Step 4: Select Instructor */}
              {addStep === 4 && (
                <div className="space-y-3">
                  <h3 className="font-serif text-base font-semibold text-deepNavy mb-3">Wybierz instruktora</h3>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    {instructors.map((instructor) => (
                      <button
                        key={instructor.id}
                        onClick={() => { setSelectedInstructor(instructor.id); setAddStep(5); }}
                        className={`p-3 rounded-xl border-2 transition-all ${
                          selectedInstructor === instructor.id
                            ? `${instructor.color} border-transparent text-white shadow-lg`
                            : 'border-iceBlue hover:border-oceanBlue text-deepNavy'
                        }`}
                      >
                        <div className="flex items-center gap-2">
                          <div className={`w-8 h-8 rounded-full ${instructor.color} flex items-center justify-center text-white font-bold text-xs`}>
                            {instructor.name.charAt(0)}
                          </div>
                          <span className="font-medium text-sm">{instructor.name}</span>
                        </div>
                      </button>
                    ))}
                  </div>
                  <div className="flex gap-2">
                    <button
                      onClick={() => setAddStep(3)}
                      className="flex-1 px-3 py-2 rounded-xl border border-iceBlue text-deepNavy hover:bg-iceBlue transition-colors text-sm"
                    >
                      Wstecz
                    </button>
                  </div>
                </div>
              )}

              {/* Step 5: Select Location */}
              {addStep === 5 && (
                <div className="space-y-3">
                  <h3 className="font-serif text-base font-semibold text-deepNavy mb-3">Wybierz lokalizację</h3>
                  <div className="grid grid-cols-2 gap-2">
                    {locations.map((loc) => (
                      <button
                        key={loc.value}
                        onClick={() => setSelectedLocation(loc.value as any)}
                        className={`p-3 rounded-xl border-2 transition-all flex items-center gap-2 ${
                          selectedLocation === loc.value
                            ? 'bg-gradient-to-r from-oceanBlue to-marineBlue text-white border-transparent shadow-lg'
                            : 'border-iceBlue hover:border-oceanBlue text-deepNavy'
                        }`}
                      >
                        {loc.icon}
                        <span className="text-xs font-medium">{loc.label}</span>
                      </button>
                    ))}
                  </div>
                  <div className="flex gap-2">
                    <button
                      onClick={() => setAddStep(4)}
                      className="flex-1 px-3 py-2 rounded-xl border border-iceBlue text-deepNavy hover:bg-iceBlue transition-colors text-sm"
                    >
                      Wstecz
                    </button>
                    <button
                      onClick={() => setAddStep(6)}
                      className="flex-1 px-3 py-2 rounded-xl bg-gradient-to-r from-oceanBlue to-marineBlue text-white hover:shadow-lg transition-all text-sm"
                    >
                      Dalej
                    </button>
                  </div>
                </div>
              )}

              {/* Step 6: Select Horse */}
              {addStep === 6 && (
                <div className="space-y-3">
                  <h3 className="font-serif text-base font-semibold text-deepNavy mb-3">Wybierz konia</h3>
                  
                  <label className="flex items-center gap-2 mb-3">
                    <input
                      type="checkbox"
                      checked={assignHorseLater}
                      onChange={(e) => setAssignHorseLater(e.target.checked)}
                      className="w-4 h-4 rounded border-iceBlue text-oceanBlue focus:ring-oceanBlue"
                    />
                    <span className="text-xs font-medium text-deepNavy">Przydziel konia później</span>
                  </label>
                  
                  {!assignHorseLater && (
                    <div className="grid grid-cols-2 gap-2">
                      {horses.map((horse) => (
                        <button
                          key={horse.id}
                          onClick={() => setSelectedHorse(horse.id)}
                          className={`p-3 rounded-xl border-2 transition-all flex items-center gap-2 ${
                            selectedHorse === horse.id
                              ? 'bg-gradient-to-r from-oceanBlue to-marineBlue text-white border-transparent shadow-lg'
                              : 'border-iceBlue hover:border-oceanBlue text-deepNavy'
                          }`}
                        >
                          <Maximize2 className="w-4 h-4" />
                          <span className="text-xs font-medium">{horse.name}</span>
                        </button>
                      ))}
                    </div>
                  )}

                  <div className="flex gap-2">
                    <button
                      onClick={() => setAddStep(5)}
                      className="flex-1 px-3 py-2 rounded-xl border border-iceBlue text-deepNavy hover:bg-iceBlue transition-colors text-sm"
                    >
                      Wstecz
                    </button>
                    <button
                      onClick={handleAddEventSubmit}
                      disabled={assignHorseLater ? false : !selectedHorse}
                      className="flex-1 px-3 py-2 rounded-xl bg-gradient-to-r from-oceanBlue to-marineBlue text-white disabled:opacity-50 disabled:cursor-not-allowed hover:shadow-lg transition-all flex items-center justify-center gap-2 text-sm"
                    >
                      <Check className="w-4 h-4" />
                      Zapisz
                    </button>
                  </div>
                </div>
              )}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Event Details Modal */}
      {showEventModal && selectedEvent && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-3xl shadow-2xl w-full max-w-lg max-h-[95vh] overflow-y-auto">
            <div className="p-6">
              <div className="flex items-center justify-between mb-6">
                <h2 className="font-serif text-2xl font-bold text-deepNavy">Szczegóły zajęć</h2>
                <button
                  onClick={() => setShowEventModal(false)}
                  className="p-2 hover:bg-iceBlue rounded-lg transition-colors"
                >
                  <X className="w-5 h-5 text-deepNavy" />
                </button>
              </div>
              <div className="space-y-4">
                <div className="flex items-center gap-3">
                  <div className="w-12 h-12 rounded-full bg-gradient-to-r from-oceanBlue to-marineBlue flex items-center justify-center text-white">
                    <User className="w-6 h-6" />
                  </div>
                  <div>
                    <div className="font-semibold text-deepNavy">
                      {instructors.find(i => i.id === selectedEvent.instructorId)?.name}
                    </div>
                    <div className="text-sm text-marineBlue">{selectedEvent.title}</div>
                  </div>
                </div>
                <div className="flex items-center gap-3 text-deepNavy">
                  <Clock className="w-5 h-5 text-marineBlue" />
                  <span>{selectedEvent.startTime} - {selectedEvent.endTime}</span>
                </div>
                <div className="flex items-center gap-3 text-deepNavy">
                  <CalendarIcon className="w-5 h-5 text-marineBlue" />
                  <span>{selectedEvent.date.toLocaleDateString('pl-PL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</span>
                </div>
                <div className="flex items-center gap-3 text-deepNavy">
                  <Users className="w-5 h-5 text-marineBlue" />
                  <span>{selectedEvent.isGroup ? 'Grupowe' : 'Indywidualne'}</span>
                </div>
                <div className="flex items-center gap-3 text-deepNavy">
                  <MapPin className="w-5 h-5 text-marineBlue" />
                  <span>{locations.find(l => l.value === selectedEvent.location)?.label}</span>
                </div>
                {selectedEvent.horseId && !selectedEvent.assignHorseLater && (
                  <div className="flex items-center gap-3 text-deepNavy">
                    <Maximize2 className="w-5 h-5 text-marineBlue" />
                    <span>{horses.find(h => h.id === selectedEvent.horseId)?.name}</span>
                  </div>
                )}
                {selectedEvent.assignHorseLater && (
                  <div className="flex items-center gap-3 text-marineBlue italic">
                    <Maximize2 className="w-5 h-5" />
                    <span>Koń do przydzielenia</span>
                  </div>
                )}
                <div className="pt-4 border-t border-iceBlue">
                  <button className="w-full px-4 py-3 rounded-xl bg-gradient-to-r from-oceanBlue to-marineBlue text-white hover:shadow-lg transition-all">
                    Edytuj zajęcia
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      <MobileNav user={user} />
    </div>
  );
}
